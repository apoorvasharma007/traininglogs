# Primary DB — Supabase connection string (session-mode pooler, port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

TEST_DATABASE_URL=postgresql://traininglogs:traininglogs@localhost:5433/traininglogs_test
# The Supabase project whose sign-ins the server accepts (public, not a secret)
SUPABASE_URL=https://<project-ref>.supabase.co
# The project's publishable key (sb_publishable_...), from Supabase: Project Settings, API Keys.
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGINS=https://yourdomain.com

# LLM parser (Track B — AI capture layer)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Only needed for keys not scoped to a workspace (sk-ant-usr...).
ANTHROPIC_WORKSPACE_ID=
# Free alternative for local testing — get a key at console.groq.com
GROQ_API_KEY=your-groq-api-key-here
# Optional overrides — defaults are set in agent/llm_parser.py
# LLM_MODEL=claude-haiku-4-5-20251001
